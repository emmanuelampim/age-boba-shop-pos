# Backend environment — copy to .env and edit. Never commit .env.
APP_PORT=4000
DB_PATH=./data/pos.db
# Automatic daily backups (db + daily sales spreadsheet) are written here.
# The "Close for the day" button creates them; see README "Backup strategy".
BACKUPS_DIR=./data/backups
# Optional: fixed folder to ALSO copy daily backups to (e.g. a USB drive).
# Empty = auto-probe removable drives on Windows (D:\-H:\, "BobaPOS Backups").
USB_BACKUP_DIR=
JWT_SECRET=dev-secret-change-me
JWT_TTL=86400
TRUST_PROXY=false
COOKIE_SECURE=false
LOG_LEVEL=info