{
  "name": "boba-pos-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Boba Shop POS API",
  "engines": {
    "node": ">=12.22.0"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "migrate": "node src/db/migrate.js",
    "seed": "node src/seed.js",
    "build:win": "node scripts/build-win.mjs",
    "start:win": "node dist/server.cjs",
    "test": "NODE_ENV=test node --test tests/api.test.js tests/customerDisplay.test.js",
    "lint": "node --check src/app.js && node --check src/index.js"
  },
  "dependencies": {
    "express": "^4.21.2",
    "sql.js": "1.8.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "supertest": "^7.1.1"
  }
}
